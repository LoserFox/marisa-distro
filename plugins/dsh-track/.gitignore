node_modules/
dist/
*.tgz
# lib/ is intentionally COMMITTED (bundle build artifact): git-source installs and the
# npm-release workflow publish it as-is (the DSH toolchain is local-only).
!lib/

.DS_Store
# per-slot tsconfig materialized by the A/B snapshot rotation (dsh-snapshot-ab)
tsconfig.ab.json
tsconfig.ab-*.json
# per-worktree tsconfig generated by scripts/setup-worktree.sh
tsconfig.worktree.json
# nested git worktrees (inside the workspace sandbox root)
.worktrees/
# gstack repo-local session state
.gstack/
