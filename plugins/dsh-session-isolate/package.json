{
  "name": "dsh-session-isolate",
  "version": "0.1.0",
  "private": true,
  "description": "Per-session Git worktree isolation for DeepSeek Harness: every session gets its own worktree and branch, turn commits land on the session branch only, and the shared checkout's Git state stays untouched.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json && pnpm run build && node --test tests/*.test.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.7",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
