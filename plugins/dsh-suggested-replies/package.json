{
  "name": "@dsh-external/dsh-suggested-replies",
  "version": "0.1.0",
  "description": "DSH Web plugin that proposes concise next user messages above the composer and inserts a selected reply into the draft without sending it.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "import": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "links": "node scripts/link-dsh.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "pnpm run clean && tsc -p tsconfig.json && tsdown -c tsdown.config.ts",
    "check": "pnpm run links && pnpm run typecheck && pnpm run test && pnpm run build && pnpm pack --dry-run",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-host-apiproxy": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.0.1-rc.2",
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/schemastery": "^3.18.1-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-client-connection": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-client-ui-conversation": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-host-apiproxy": { "optional": true },
    "@deepseek-ai/dsh-invariants": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-session-persistence": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-storage-domain": { "optional": true },
    "@deepseek-ai/dsh-system-prompt": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true },
    "@deepseek-ai/dsh-workspace": { "optional": true },
    "@deepseek-ai/cordis": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true }
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.31",
    "@types/react-dom": "~18.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
