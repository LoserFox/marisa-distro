{
  "compilerOptions": {
    "target": "ES2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    // The sources import siblings with explicit .ts/.tsx specifiers (the dsh
    // house style); tsc rewrites them to .js on emit.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // node: host 半边（src/index.ts）注册同源路由，需要 node:http / process /
    // Buffer 类型；react: 客户端 JSX。
    "types": ["react", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "emitDeclarationOnly": false
  },
  "include": ["src"]
}
