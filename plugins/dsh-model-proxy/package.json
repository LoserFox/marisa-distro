{
  "name": "dsh-model-proxy",
  "version": "0.1.0",
  "private": true,
  "description": "Route DSH model/web requests through a local SOCKS5/HTTP proxy by replacing the undici global dispatcher. Zero-config fallback to standard proxy env vars (MODEL_PROXY / ALL_PROXY / HTTPS_PROXY / HTTP_PROXY) with NO_PROXY exemptions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json && pnpm run build && node --test tests/*.test.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "undici": "^7.29.0"
  },
  "peerDependencies": {
    "cordis": "^4.0.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cordis": "4.0.0-rc.7",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
