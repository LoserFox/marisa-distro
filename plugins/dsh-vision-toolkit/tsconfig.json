{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"],
    "rootDir": "src",
    "outDir": "lib",
    "declarationDir": "lib/types",
    "composite": false,
    "incremental": false,
    "noEmitOnError": true,
    "tsBuildInfoFile": "lib/.tsbuildinfo",
    "paths": {
      "cordis": ["../../harness/vendor/cordis/lib/types/index.d.ts"],
      "schemastery": ["../../harness/vendor/schemastery/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-agent": ["../../harness/packages/core/agent/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-tools": ["../../harness/packages/core/tools/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-credentials": ["../../harness/packages/credentials/credentials/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-skill": ["../../harness/packages/skill/skill/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-subprocess": ["../../harness/packages/subprocess/subprocess/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-settings": ["../../harness/packages/settings/settings/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-host-webserver": ["../../harness/packages/host/webserver/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-llm": ["../../harness/packages/llm/llm/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-session": ["../../harness/packages/core/session/lib/types/index.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["tests", "src/client", "lib", ".client-build", "node_modules"]
}
