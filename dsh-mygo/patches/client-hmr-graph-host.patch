+  /**
+   * Mounted-row membership the last graph frame established (`undefined`
+   * before the first frame). Seeded from the connect-time baseline so the
+   * diff only ever touches rows some graph once listed — shell-own entries
+   * (modules wrapper, app-shell assembly) live in the loader tree but never
+   * in a graph, and are never mounted or removed here.
+   */
+  let knownGraphIds: Set<string> | undefined
+
+  /**
+   * Apply one graph frame as a membership diff: mount added rows, dispose
+   * removed rows. Mount reuses the boot path's own verbs (prefetch registers
+   * the factory, `loader.create` imports and materializes through the
+   * Loader); disposal reuses reload()'s documented teardown (registry-first
+   * so the Loader does not flag the entry disabled, drain the old fiber's
+   * unload, drop owned styles) and then removes the entry from the tree.
+   * Content changes (same id, new rev) stay with rebuilt frames.
+   * @param graph - the graph payload of a `graph` frame.
+   */
+  async function applyGraph(graph: WebBootGraph): Promise<void> {
+    const wanted = new Set(graph.entries.map(row => row.id))
+    const known = knownGraphIds ?? wanted
+    knownGraphIds = wanted
+    for (const row of graph.entries) {
+      if (known.has(row.id) || findEntry(loader, row.id) !== undefined) continue
+      await modLoader.prefetch(row.id)
+      await loader.create({ name: row.id })
+    }
+    for (const id of known) {
+      if (wanted.has(id)) continue
+      const entry = findEntry(loader, id)
+      if (entry === undefined) continue
+      const oldFiber = entry.fiber
+      if (oldFiber !== undefined) {
+        const runtime = oldFiber.runtime
+        if (runtime !== null) entry.ctx.registry.delete(runtime.callback)
+        while (oldFiber.inertia !== undefined) await oldFiber.inertia
+        delete entry.fiber
+      }
+      removeOwnedStyles(id)
+      await loader.remove(entry.id)
+    }
+  }
