diff --git a/apps/cli/tests/fabric-bootstrap-runner.mjs b/apps/cli/tests/fabric-bootstrap-runner.mjs
new file mode 100644
index 0000000..2adf26d
--- /dev/null
+++ b/apps/cli/tests/fabric-bootstrap-runner.mjs
@@ -0,0 +1,39 @@
+/**
+ * Child-process harness for the CLI Fabric bootstrap spec.
+ *
+ * The launcher's `installFabricBootstrap` imports `cordis-fabric`
+ * through the package root, which resolves to the built `lib/` half — the
+ * same resolution a source-mode or built `dsh` launch performs. The runtime
+ * registry must come from that same half, so this runner imports the package
+ * root too: mixing `src` and `lib` would split the bridge listeners across
+ * two module instances and no handler would ever see a transformed call.
+ */
+
+import { existsSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import { fileURLToPath } from 'node:url'
+import { runtime } from 'cordis-fabric'
+import { installFabricBootstrap } from 'cordis-fabric-dsh/profile-bootstrap'
+
+const require = createRequire(import.meta.url)
+const fixturePath = fileURLToPath(new URL('./fixtures/node_modules/fabric-bootstrap-fixture/index.cjs', import.meta.url))
+
+const target = {
+  module: 'fabric-bootstrap-fixture',
+  versionRange: '^1.0.0',
+  filePath: 'index.cjs',
+  functionQuery: { methodName: 'add', kind: 'Sync' },
+}
+
+const rows = new Map([
+  ['cordis-fabric', { config: { fabric: { patches: [{ id: 'boot/add', target, operation: 'before' }] } } }],
+])
+
+await installFabricBootstrap(rows)
+const mod = require(fixturePath)
+runtime.register({ id: 'boot/add', target, operation: 'before', priority: 0, enabled: false })
+runtime.enable('boot/add', (call) => { call.arguments[0] = call.arguments[0] * 10 })
+const actual = mod.add(2, 3)
+const ok = actual === 23
+console.log(`${ok ? 'PASS' : 'FAIL'} bootstrap add(2,3): ${JSON.stringify(actual)}`)
+if (!ok) process.exitCode = 1
diff --git a/apps/cli/tests/fabric-bootstrap.spec.ts b/apps/cli/tests/fabric-bootstrap.spec.ts
