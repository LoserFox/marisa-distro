--- /dev/null
+++ b/scripts/dev-web-fabric.spec.ts
@@ -0,0 +1,81 @@
+/**
+ * End-to-end proof of the Fabric browser build trigger: a client bundle
+ * whose tsdown config wires `clientBundle(..., { transform: createWatchedBrowserTransform(...) })`
+ * rebuilds under watch mode when the patches file (not any source module)
+ * changes, because the transform registers the file in the watch graph
+ * through the preset-forwarded addWatchFile. The rewritten bundle is what
+ * the client-hmr chain (stat poll → rebuilt frame → fiber swap) delivers
+ * to the browser.
+ *
+ * The fixture's tsdown.config.ts mirrors a real client package's config and
+ * imports the preset and the Fabric factory by absolute path, exactly as
+ * `scripts/dev-web.ts` drives package configs in workspace mode.
+ */
+import { mkdtemp, mkdir, readFile, rm, symlink, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { expect, it } from 'vitest'
+import type { TsdownBundle } from 'tsdown'
+import { watchClientPlugins } from './dev-web.ts'
+
+it('rebuilds a client bundle when the watched Fabric patches file changes', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-dev-web-fabric-'))
+  let bundles: TsdownBundle[] = []
+  try {
+    await symlink(join(import.meta.dirname, '..', 'node_modules'), join(root, 'node_modules'), 'dir')
+    await writeFile(join(root, 'package.json'), JSON.stringify({ name: '@dsh-test/dev-web-fabric', private: true, type: 'module' }))
+    await mkdir(join(root, 'src/client'), { recursive: true })
+    await writeFile(join(root, 'src/client/index.ts'), 'export function add(a: number, b: number): number { return a + b }\n')
+    await mkdir(join(root, 'lib/types/client'), { recursive: true })
+    await writeFile(join(root, 'lib/types/client/index.js'), 'export function add(a, b) { return a + b }\n')
+    const patchesPath = join(root, 'fabric.patches.json')
+    const patch = {
+      id: 'web/before-add',
+      target: {
+        module: '@dsh-test/dev-web-fabric',
+        versionRange: '^1.0.0',
+        filePath: 'client/index.js',
+        functionQuery: { functionName: 'add', kind: 'Sync' },
+      },
+      operation: 'before',
+    }
+    await writeFile(patchesPath, JSON.stringify([patch]))
+
+    const repoRoot = join(import.meta.dirname, '..')
+    await writeFile(join(root, 'tsdown.config.ts'), `
+import { clientBundle } from ${JSON.stringify(join(repoRoot, 'packages/client/tsdown.client.ts'))}
+import { createWatchedBrowserTransform, repoSourceResolver } from ${JSON.stringify(join(repoRoot, 'packages/extensions/cordis-fabric/src/browser-transform.ts'))}
+
+const fabric = createWatchedBrowserTransform(
+  ${JSON.stringify(patchesPath)},
+  repoSourceResolver('@dsh-test/dev-web-fabric', ${JSON.stringify(join(root, 'lib/types'))}, '1.0.0'),
+)
+
+export default clientBundle('@dsh-test/dev-web-fabric', ['lib/types/index.js'], { transform: fabric, hostPhase: true })({ env: { DSH_BUILD_FACE: 'client' } })[0]
+`)
+
+    bundles = await watchClientPlugins(root, ['.'], 50)
+
+    const bundlePath = join(root, 'lib/client.js')
+    await expect.poll(async () => {
+      try {
+        return (await readFile(bundlePath, 'utf8')).includes('__dshFabricBridge')
+      } catch {
+        return false
+      }
+    }, { timeout: 10_000 }).toBe(true)
+    expect(await readFile(bundlePath, 'utf8')).toContain('web/before-add')
+
+    // Let the watcher settle, then empty the patch set: the rebuild must
+    // re-run the transform (watch-file invalidation), so the bridge
+    // machinery disappears from the bundle without any source change.
+    await new Promise(resolve => setTimeout(resolve, 1_000))
+    await writeFile(patchesPath, '[]')
+    await expect.poll(async () => (await readFile(bundlePath, 'utf8')).includes('__dshFabricBridge'), {
+      timeout: 10_000,
+    }).toBe(false)
+  } finally {
+    for (const bundle of bundles) await bundle[Symbol.asyncDispose]()
+    await rm(root, { recursive: true, force: true })
+  }
+}, 30_000)
