+++ b/apps/cli/tests/fabric-bootstrap.spec.ts
@@ -0,0 +1,46 @@
+import { spawnSync } from 'node:child_process'
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { describe, expect, it } from 'vitest'
+import { installFabricBootstrap } from 'cordis-fabric-dsh/profile-bootstrap'
+
+const runner = fileURLToPath(new URL('./fabric-bootstrap-runner.mjs', import.meta.url))
+// Vitest runs from the repository root; the bootstrap resolves the package
+// root to its built lib half, so this suite requires `pnpm run build`.
+const fabricLib = join(process.cwd(), 'packages/extensions/cordis-fabric/lib/index.js')
+describe.skipIf(!existsSync(fabricLib))('cordis-fabric host bootstrap', () => {
+  it('installs transformation hooks from the composed cordis-fabric row', () => {
+    const result = spawnSync(process.execPath, ['--import', 'tsx/esm', runner], {
+      cwd: fileURLToPath(new URL('../..', import.meta.url)),
+      encoding: 'utf8',
+      env: { ...process.env },
+    })
+    expect(result.status, `${result.stdout}\n${result.stderr}`).toBe(0)
+    expect(result.stdout).toContain('PASS bootstrap add(2,3): 23')
+  })
+
+  it('no-ops when the composed rows carry no cordis-fabric row or patches', async () => {
+    await expect(installFabricBootstrap(new Map())).resolves.toBeUndefined()
+    await expect(installFabricBootstrap(new Map([['cordis-fabric', { config: {} }]]))).resolves.toBeUndefined()
+  })
+
+  it('reads config.fabric.patches without a deprecation warning', async () => {
+    const warnings: string[] = []
+    await installFabricBootstrap(
+      new Map([['cordis-fabric', { config: { fabric: { patches: [] } } }]]),
+      (message) => { warnings.push(message) },
+    )
+    expect(warnings).toEqual([])
+  })
+
+  it('honors the deprecated config.patches key with a warning', async () => {
+    const warnings: string[] = []
+    await installFabricBootstrap(
+      new Map([['cordis-fabric', { config: { patches: [] } }]]),
+      (message) => { warnings.push(message) },
+    )
+    expect(warnings).toHaveLength(1)
+    expect(warnings[0]).toContain('config.patches is deprecated')
+  })
+})
