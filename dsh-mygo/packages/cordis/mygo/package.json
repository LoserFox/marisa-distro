{
  "name": "@r05en1cu/dsh-mygo",
  "description": "Managed-plugin lifecycle and mount-time validation bridge between the dsh-mygo-api contract and Cordis",
  "version": "0.2.0-rc.7",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/omdsh-dev/dsh-mygo.git"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts",
    "src"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b && tsdown",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "prepare": "node scripts/prepare.mjs",
    "prepack": "node -e \"const fs=require('fs'); if(!fs.existsSync('lib/index.js')||!fs.existsSync('lib/types/index.d.ts')){console.error('lib 缺失：请先在仓库内构建（pnpm run build：tsc -b + tsdown）'); process.exit(1)}\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-invariants": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-storage": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.0.1-rc.1 <0.2.0",
    "@deepseek-ai/schemastery": "3.18.1-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@r05en1cu/dsh-mygo-api": "workspace:^",
    "zod": "^4.4.3",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "@deepseek-ai/schemastery": "3.18.1-rc.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@r05en1cu/dsh-mygo-api": "workspace:^",
    "@deepseek-ai/dsh-skill": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "@deepseek-ai/dsh-storage-sqlite": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-timeout": "workspace:^",
    "@deepseek-ai/dsh-tool-cordis": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@deepseek-ai/dsh-storage-json": "workspace:^",
    "@deepseek-ai/dsh-home-paths": "workspace:^",
    "schemastery": "^3.18.0",
    "@types/js-yaml": "^4.0.9"
  },
  "author": "r05En1cU",
  "maintainers": [
    "r05En1cU"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
