{
  "name": "@r05en1cu/dsh-mygo-ext-panel",
  "version": "0.2.0-rc.7",
  "description": "MyGO managed-plugin panel for the dsh web settings page (settings.section slot + /api/mygo/* routes)",
  "author": "r05En1cU",
  "maintainers": [
    "r05En1cU"
  ],
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@r05en1cu/dsh-mygo": "workspace:^",
    "@r05en1cu/dsh-mygo-api": "workspace:^",
    "@r05en1cu/dsh-mygo-loader-hub": "workspace:^",
    "@r05en1cu/dsh-mygo-loader-profile": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.12",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "lightningcss": "^1.27.0",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "../../../node_modules/.pnpm/node_modules/.bin/vitest run",
    "verify:self-contained": "node scripts/verify-self-contained.mjs",
    "prepare": "tsc -p tsconfig.json && tsdown --config tsdown.config.mjs",
    "prepack": "node -e \"const fs=require('fs'); if(!fs.existsSync('lib/index.js')||!fs.existsSync('lib/client.js')||!fs.existsSync('lib/types/index.d.ts')){console.error('lib 缺失：请先 pnpm run build'); process.exit(1)}\""
  }
}
