# Marisa DSH desktop build recipes。

# 用法（仓库根执行）：
#   just build-windows   构建 Windows 窗口壳 -> release/dsh-shell.exe

# 构建开发版 Windows 窗口壳（后端使用用户环境里的 dsh）。
[working-directory("..")]
build-windows:
    go build -C desktop -o release/dsh-shell.exe .

# 运行构建产物（Windows）。
[working-directory("..")]
run:
    release/dsh-shell.exe
